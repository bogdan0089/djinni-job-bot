# Required — get it from @BotFather
BOT_TOKEN=123456:AAAA-your-telegram-bot-token

# Database (SQLite by default; PostgreSQL works too)
DATABASE_URL=sqlite+aiosqlite:///bot.db
# DATABASE_URL=postgresql+asyncpg://bot:bot@db:5432/bot
DB_ECHO=false

LOG_LEVEL=INFO

# Daily digest schedule
TIMEZONE=Europe/Kyiv
DIGEST_HOUR=9
DIGEST_MINUTE=0

# Parser
HTTP_TIMEOUT=10
JOBS_PER_REQUEST=10
PARSER_CACHE_TTL=900

# Anti-flood: min seconds between two updates from the same user
THROTTLE_RATE=0.7
